#!/bin/sh
# Format staged files before they are committed.
#
# CI gates on `prettier --check`, and the usual way to fail it is to edit a file after running the
# formatter — which is exactly what happened once already. Formatting here removes the race.
set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR |
  grep -E '\.(ts|tsx|js|jsx|mjs|json|css|md|yml|yaml)$' || true)

[ -z "$staged" ] && exit 0

echo "$staged" | xargs npx prettier --write --ignore-unknown >/dev/null
echo "$staged" | xargs git add
