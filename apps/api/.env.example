NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/nasl
MONGODB_DB_NAME=nasl

# 32+ random characters. Keep a stable value across deployments.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
# Generous by design: a herder may be offline for weeks (scope NFR-01).
REFRESH_TOKEN_TTL_DAYS=30

LOG_LEVEL=info

# Production: comma-separated exact frontend origins, without trailing slashes.
CORS_ORIGINS=
MONGO_MAX_POOL_SIZE=5

# Administrator email invitations (leave sender secrets unset until configured).
ADMIN_APP_URL=http://localhost:5174
# RESEND_API_KEY=
# ADMIN_INVITE_FROM=invites@example.com
