NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/nasl
MONGODB_DB_NAME=nasl

# 32+ random characters. Keep a stable value across deployments.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
# Generous by design: a herder may be offline for weeks (scope NFR-01).
REFRESH_TOKEN_TTL_DAYS=30

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# Local development only. Production uses disabled until a real provider is configured.
SMS_PROVIDER=log
LOG_LEVEL=info

# Production: comma-separated exact frontend origins, without trailing slashes.
CORS_ORIGINS=
MONGO_MAX_POOL_SIZE=5
# Only needed with SMS_PROVIDER=twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
