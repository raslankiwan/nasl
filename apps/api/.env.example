NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/nasl

# 32+ chars. Rotate by appending to JWT_SECRET_PREVIOUS for a grace period.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
# Generous by design: a herder may be offline for weeks (scope NFR-01).
REFRESH_TOKEN_TTL_DAYS=30

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# When unset in development, the code is written to the log instead of sent by SMS.
SMS_PROVIDER=log
LOG_LEVEL=info
