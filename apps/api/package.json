{
  "name": "@nasl/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --experimental-strip-types src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.vercel.json --noEmit",
    "test": "node --test --experimental-strip-types --test-concurrency=1 'src/**/*.test.ts'",
    "db:prepare": "node --env-file-if-exists=.env --experimental-strip-types scripts/prepare-database.ts",
    "admin:seed": "node --env-file-if-exists=.env --experimental-strip-types scripts/seed-first-admin.ts"
  },
  "dependencies": {
    "@nasl/i18n": "*",
    "@nasl/shared": "*",
    "@simplewebauthn/server": "^14.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "mongoose": "^8.9.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/web-push": "^3.6.4",
    "mongodb-memory-server": "^10.1.3",
    "typescript": "^5.7.3"
  }
}
