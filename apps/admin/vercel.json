{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && MONGOMS_DISABLE_POSTINSTALL=1 npm ci --include=dev --workspace @nasl/admin --workspace @nasl/shared --workspace @nasl/i18n --include-workspace-root",
  "buildCommand": "cd ../.. && npm run build:packages && npm run build -w @nasl/admin",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
