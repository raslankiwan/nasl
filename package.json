{
  "name": "nasl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Nasl (نَسْل) — Arabic-first, offline-first flock management for sheep and goats",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "build:packages": "npm run build -w @nasl/shared -w @nasl/i18n",
    "pretest": "npm run build:packages",
    "pretypecheck": "npm run build:packages"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.0",
    "eslint": "^9.20.0",
    "globals": "^17.12.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0"
  }
}
